rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dishes collection: allow public read, and allow create/update/delete for canteen management
    match /dishes/{dishId} {
      allow read, write: if true;
    }

    // Orders collection: allow students to place orders, kitchen & admin to view & update
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Reviews collection: allow students to submit reviews and admin to reply
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // App state & settings: allow read/write
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
